# Copy to android/key.properties and fill in after creating a upload keystore.
# NEVER commit key.properties or *.jks to git.
#
# Create keystore (one-time):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storePassword and keyPassword are often the SAME (what keytool asked twice).
# If they differ, use the exact passwords from keystore creation.
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_STORE_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
